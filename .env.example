APP_NAME=CrowdChain
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=crowdchain
DB_USERNAME=crowdchain
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Domains whose browser requests use cookie sessions (D-44). Include the Vite
# dev server (5173) and `php artisan serve` (8000). In production: your domain.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1:8000,localhost:5173

# --- CrowdChain (docs/16-auth-and-security-flows.md §7) ---------------------
# Blockchain. Sepolia = 11155111, local Hardhat node = 31337.
CHAIN_ID=11155111
SEPOLIA_RPC_URL=
CONTRACT_ADDRESS=
CONTRACT_DEPLOY_BLOCK=0
ADMIN_WALLET_ADDRESS=
CHAIN_EXPLORER_URL=https://sepolia.etherscan.io

# ETH -> MYR rate
COINGECKO_API_KEY=

# Admin account created by: php artisan db:seed (required, no defaults)
ADMIN_NAME="CrowdChain Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Uploaded files: "local" in development, "r2" in production
DOCUMENTS_DISK=local

# Cloudflare R2 (S3-compatible) — production only
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

