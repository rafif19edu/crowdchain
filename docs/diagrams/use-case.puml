@startuml use-case
title CrowdChain — Use Case Diagram
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor Guest
actor "Registered User" as RU
actor Donor
actor Fundraiser
actor Admin
actor "Scheduler" as SCH <<system>>
actor "Ethereum Sepolia\n(via MetaMask)" as ETH <<system>>

RU <|-- Donor
RU <|-- Fundraiser
RU <|-- Admin

rectangle "CrowdChain" {
  usecase "UC01 Browse & Search Campaigns" as UC01
  usecase "UC02 View Campaign Details\n(Trust Score, timeline)" as UC02
  usecase "UC03 Register" as UC03
  usecase "UC04 Log In / Log Out" as UC04
  usecase "UC05 Manage Profile" as UC05
  usecase "UC06 Reset Password" as UC06
  usecase "UC07 Link Wallet" as UC07
  usecase "UC08 View Notifications" as UC08

  usecase "UC09 Donate" as UC09
  usecase "UC10 View Donation History" as UC10
  usecase "UC11 Claim Refund" as UC11

  usecase "UC12 Submit Organisation\nVerification" as UC12
  usecase "UC13 Renew Registration" as UC13
  usecase "UC14 Create Campaign\n(Project / Weekly)" as UC14
  usecase "UC15 Submit Campaign\nfor Review" as UC15
  usecase "UC16 Edit Approved Campaign" as UC16
  usecase "UC17 Request Extension" as UC17
  usecase "UC18 Request Stage Release" as UC18
  usecase "UC19 Submit Proof of Spending" as UC19
  usecase "UC20 Post Progress Update" as UC20

  usecase "UC21 Verify Organisation" as UC21
  usecase "UC22 Review Campaign" as UC22
  usecase "UC23 Review Extension" as UC23
  usecase "UC24 Release Stage" as UC24
  usecase "UC25 Mark Week Unfunded" as UC25
  usecase "UC26 Review Proof" as UC26
  usecase "UC27 Cancel Campaign" as UC27
  usecase "UC28 Manage Users" as UC28
  usecase "UC29 View Audit Log" as UC29
  usecase "UC30 Pause / Unpause Contract" as UC30
  usecase "UC31 View Pending Actions" as UC31

  usecase "UC32 Sync Chain Events" as UC32
  usecase "UC33 Recalculate Trust Score" as UC33
  usecase "UC34 Check Expiry & Overdue Proof" as UC34
}

Guest --> UC01
Guest --> UC02
Guest --> UC03
Guest --> UC04
Guest --> UC06

RU --> UC05
RU --> UC08
RU --> UC01
RU --> UC02

Donor --> UC07
Donor --> UC09
Donor --> UC10
Donor --> UC11

Fundraiser --> UC07
Fundraiser --> UC12
Fundraiser --> UC13
Fundraiser --> UC14
Fundraiser --> UC15
Fundraiser --> UC16
Fundraiser --> UC17
Fundraiser --> UC18
Fundraiser --> UC19
Fundraiser --> UC20

Admin --> UC21
Admin --> UC22
Admin --> UC23
Admin --> UC24
Admin --> UC25
Admin --> UC26
Admin --> UC27
Admin --> UC28
Admin --> UC29
Admin --> UC30
Admin --> UC31

SCH --> UC32
SCH --> UC33
SCH --> UC34

UC09 ..> UC07 : <<include>>\n(wallet required)
UC15 ..> UC12 : <<include>>\n(verified org required)
UC22 .> ETH : createCampaign
UC09 .> ETH : donate
UC11 .> ETH : claimRefund
UC23 .> ETH : extendDeadline
UC24 .> ETH : releaseStage
UC25 .> ETH : markUnfunded
UC26 .> ETH : recordProof
UC27 .> ETH : cancelCampaign
UC30 .> ETH : pause/unpause
UC32 .> ETH : read events
@enduml
